# Kopiera till .env (gitignorerad). Lägg aldrig riktiga tokens i git.
#
# --- CapRover (spelserver) — används av npm run deploy:caprover ---
CAPROVER_URL=https://captain.apps.dipper.digital
CAPROVER_APP=bv-server
CAPROVER_APP_TOKEN=
CAPROVER_APP_STAGING=bv-server-staging
CAPROVER_APP_TOKEN_STAGING=
#
# --- Vercel (web) — kör "npx vercel login" om du deployar med CLI ---
# Sätt VITE_WS_URL i Vercel Dashboard (Production) till wss://<din-server-app>
# Sätt VITE_SITE_URL till publik webb-URL för sitemap och delningslänkar.
# Produktion: https://spela.bryggverket.se (Vercel custom domain)
VITE_SITE_URL=https://spela.bryggverket.se

# --- Auth (OTP + Google) ---
AUTH_STORE_DRIVER=file
AUTH_STORE_PATH=./.data/auth-store.json
AUTH_SESSION_COOKIE=bv_session
AUTH_SESSION_TTL_MS=2592000000
AUTH_OTP_TTL_MS=600000
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_DEV_OTP_LOG=true
AUTH_TEST_OTP_CODE=123456
AUTH_REQUIRE_HOST_LOGIN=false

# OTP e-post via Resend (valfritt i dev när AUTH_DEV_OTP_LOG=true)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Google Forms — valfri feedback efter avslutat parti (mobil). Se docs/PLAYTEST_FEEDBACK_FORM.md
# VITE_FEEDBACK_FORM_BASE=https://docs.google.com/forms/d/e/1FAIpQLSd78GPKV2lkRucoULPv1Dmyr8cw9fqoQowE786Beh8O8JZyOw/viewform
# VITE_FEEDBACK_ENTRY_PLAYERS=738094630
# VITE_FEEDBACK_ENTRY_MINUTES=285181796
# VITE_FEEDBACK_ENTRY_LEVELS=1084354622
# VITE_FEEDBACK_ENTRY_DIFFICULTY=903916440

# Google OAuth (valfritt tills ni slår på Google-login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Admin token for /admin/* and /stats
ADMIN_TOKEN=
# Append-only match analytics log
ANALYTICS_PATH=./.data/analytics.json
