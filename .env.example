# Kopiera till .env (gitignorerad). Lägg aldrig riktiga tokens i git.
#
# --- CapRover (spelserver) — används av npm run deploy:caprover ---
CAPROVER_URL=https://captain.apps.dipper.digital
CAPROVER_APP=bv-server
CAPROVER_APP_TOKEN=
CAPROVER_APP_STAGING=bv-server-staging
CAPROVER_APP_TOKEN_STAGING=
#
# --- Vercel (web) — kör "npx vercel login" om du deployar med CLI ---
# Sätt VITE_WS_URL i Vercel Dashboard (Production) till wss://<din-server-app>
