{
  "name": "bv-boardgame",
  "version": "0.9.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "deploy:caprover": "dotenv -e .env -- sh -c 'caprover deploy -u \"$CAPROVER_URL\" -a \"$CAPROVER_APP\" --appToken \"$CAPROVER_APP_TOKEN\"'",
    "deploy:caprover:staging": "dotenv -e .env -- sh -c 'caprover deploy -u \"$CAPROVER_URL\" -a \"$CAPROVER_APP_STAGING\" --appToken \"$CAPROVER_APP_TOKEN_STAGING\"'",
    "build": "npm run -w @bv/game-core build && npm run -w server build && npm run -w web build",
    "dev": "npm run -w @bv/game-core build && concurrently -n server,web -c magenta,green \"npm run -w server dev\" \"node scripts/wait-for-server.mjs && npm run -w web dev\"",
    "dev:server": "npm run -w server dev",
    "dev:web": "npm run -w web dev",
    "smoke:server": "npm run -w server smoke",
    "auth:smoke:server": "npm run -w server auth:smoke",
    "e2e:server": "npm run -w server e2e",
    "migrate:check:server": "npm run -w server migration:check",
    "load:check:server": "npm run -w server load:check",
    "optimize:images": "node scripts/optimize-images.mjs",
    "optimize:images:force": "node scripts/optimize-images.mjs --force",
    "optimize:images:check": "node scripts/optimize-images.mjs --check",
    "optimize:sfx": "node scripts/optimize-sfx.mjs",
    "optimize:sfx:force": "node scripts/optimize-sfx.mjs --force",
    "optimize:sfx:check": "node scripts/optimize-sfx.mjs --check"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "dotenv-cli": "^11.0.0",
    "sharp": "^0.34.5",
    "typescript": "^5.6.3"
  },
  "packageManager": "npm@10"
}
